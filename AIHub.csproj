<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>AIHub</AssemblyName>
    <Version>0.3.1</Version>
    <ApplicationIcon>Assets\AIHub.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Usage\**\*.cs" />
    <ProjectReference Include="Usage\AIHub.Usage.csproj" />
    <EmbeddedResource Include="Assets\AIHub.ico" />
    <EmbeddedResource Include="Assets\Providers\*.png" />
  </ItemGroup>
</Project>
